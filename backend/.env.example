# =============================================================================
# Mindexa Platform — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in all required values.
#
#   cp .env.example .env
#
# REQUIRED fields have no default and MUST be set or the app will refuse to start.
# DO NOT commit .env to version control — it is in .gitignore.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Mindexa Platform"
APP_VERSION="1.0.0"

# development | staging | production
ENVIRONMENT=development

DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ── Secrets (REQUIRED) ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Auth ──────────────────────────────────────────────────────────────────────
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=60
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
REFRESH_TOKEN_COOKIE_NAME=mindexa_refresh
# Set to true in production (requires HTTPS)
ACCESS_TOKEN_COOKIE_SECURE=false

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Sync URL — used by Alembic for migrations
# Docker-specific database config (matches docker-compose)
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5433/mindexa_db
# Async URL — derived from DATABASE_URL automatically if left blank
# DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5433/mindexa_db

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=true
# Set to true only for local SQL debugging — never in production
DATABASE_ECHO=false

# Docker-specific (used in docker-compose.yml)
POSTGRES_DB=mindexa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5433

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_CACHE_DEFAULT_TTL=300
REDIS_USER_PROFILE_TTL=600
REDIS_ASSESSMENT_TTL=120
REDIS_REVOKED_JTI_TTL=604800

REDIS_PORT=6379

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Set to true in test environments for synchronous task execution
CELERY_TASK_ALWAYS_EAGER=false

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Set to true in staging/production for JSON structured logs
LOG_JSON=false
LOG_ACCESS=true

# ── Monitoring ────────────────────────────────────────────────────────────────
METRICS_ENABLED=false
METRICS_API_KEY=
# Optional: Sentry DSN for error tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_STUDENT_AI_SUPPORT_PER_HOUR=30
RATE_LIMIT_FAIL_CLOSED_ON_AI=false
# Reverse proxies in front of the API (nginx, Caddy, a PaaS router). 0 = no proxy: X-Forwarded-For is
# ignored because clients can forge it. Set to 1 (or more) in production behind proxies, otherwise every
# user shares the proxy's address in the login / refresh limits and the account lockout.
TRUSTED_PROXY_COUNT=0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. NO wildcards in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
FRONTEND_URL=http://localhost:3000

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL=noreply@mindexa.ac
EMAILS_FROM_NAME="Mindexa Platform"
# Set to false in production to actually send emails
EMAIL_DEV_MODE=true

# ── File Storage ──────────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=uploads
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.txt,.png,.jpg,.jpeg

# Student personal uploads (study tutor / reader). Every upload is embedded by a paid provider,
# so these cap the cost per student. Only formats the RAG pipeline can process are accepted.
MAX_STUDENT_UPLOAD_SIZE_MB=10
STUDENT_ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt
STUDENT_MAX_RESOURCES=30
STUDENT_STORAGE_QUOTA_MB=200
# Refuse pathological documents (huge page counts / decompression bombs)
MAX_DOCUMENT_PAGES=1000
MAX_DOCUMENT_CHUNKS=5000

# ... (AWS S3 section)

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Providers are tried in order with automatic fallback; configure at least one.
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JINA_API_KEY=your-jina-api-key-here
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-haiku-5-5
DEFAULT_EMBEDDING_PROVIDER=jina
DEFAULT_EMBEDDING_MODEL=jina-embeddings-v3
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
# Wall-clock cap for one AI call including all retries and provider fallbacks
AI_TOTAL_TIMEOUT_SECONDS=90
# Rolling 24h completion-token budget per user, by role (0 disables the limit)
AI_DAILY_TOKEN_BUDGET_STUDENT=300000
AI_DAILY_TOKEN_BUDGET_LECTURER=1000000

# ── Rate limits (requests per window, per user) ───────────────────────────────
RATE_LIMIT_UPLOAD_PER_MINUTE=10
# true = refuse AI requests when Redis (the shared limiter) is down instead of counting per process
RATE_LIMIT_FAIL_CLOSED_ON_AI=false

# ── Study planner ─────────────────────────────────────────────────────────────
# Students pick session times ("19:00") in local time; this is the local offset from UTC in
# minutes (Africa/Kigali = +120, no DST). Sessions are stored in UTC.
STUDY_PLANNER_UTC_OFFSET_MINUTES=120

# ── RAG Parameters ────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# ── Vector Store (pgvector) ───────────────────────────────────────────────────
# Must match the embedding model's output size and the vector column in the database.
PGVECTOR_DIMENSION=1536

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── App port (for docker-compose) ─────────────────────────────────────────────
APP_PORT=8000
